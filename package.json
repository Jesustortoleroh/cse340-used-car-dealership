{
    "name": "used-car-dealership",
    "version": "1.0.0",
    "description": "A full-stack used car dealership application built with Node.js, Express, EJS, and PostgreSQL (Neon).",
    "type": "module",
    "main": "server.js",
    "engines": {
        "node": ">=20.0.0"
    },
    "scripts": {
        "dev": "nodemon --env-file=.env server.js",
        "start": "node server.js",
        "test": "node --test",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write ."
    },
    "keywords": [
        "nodejs",
        "express",
        "ejs",
        "postgresql",
        "neon",
        "car-dealership",
        "fullstack",
        "esm"
    ],
    "author": "Jesus Tortolero",
    "license": "MIT",
    "packageManager": "pnpm@10.28.2",
    "dependencies": {
        "bcrypt": "^6.0.0",
        "compression": "^1.8.2",
        "connect-pg-simple": "^10.0.0",
        "csrf-sync": "^4.2.1",
        "dotenv": "^16.4.7",
        "ejs": "^6.0.1",
        "express": "^5.2.1",
        "express-rate-limit": "^8.7.4",
        "express-session": "^1.19.0",
        "express-validator": "^7.3.2",
        "helmet": "^8.3.0",
        "passport": "^0.7.0",
        "passport-github2": "^0.1.12",
        "passport-google-oauth20": "^2.0.0",
        "pg": "^8.21.0",
        "pino": "^10.4.0",
        "pino-http": "^11.0.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.14.0",
        "nodemon": "^3.1.11",
        "pino-pretty": "^13.2.0",
        "prettier": "^3.10.1",
        "ws": "^8.20.0"
    }
}
