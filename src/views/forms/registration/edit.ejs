<%- include('../../partials/header') %>

<main class="edit-page">

    <div class="edit-card glass-card">
        <h1 class="edit-title"><%= title %></h1>
        <p class="edit-subtitle">Update your dealership account information below.</p>

        <form
            method="POST"
            action="/register/<%= user.id %>/edit"
            class="account-form"
            novalidate
        >
            <!-- CSRF Token (Required for security) -->
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <!-- Full Name -->
            <div class="form-group">
                <label for="name">Full Name</label>
                <input
                    type="text"
                    id="name"
                    name="name"
                    value="<%= user.name %>"
                    required
                    minlength="2"
                    maxlength="100"
                    pattern="[a-zA-Z\s'-]+"
                    title="Letters, spaces, hyphens, and apostrophes only"
                >
                <small class="help-text">
                    Between 2 and 100 characters.
                </small>
            </div>

            <!-- Email Address -->
            <div class="form-group">
                <label for="email">Email Address</label>
                <input
                    type="email"
                    id="email"
                    name="email"
                    value="<%= user.email %>"
                    required
                    maxlength="255"
                >
                <small class="help-text">
                    Enter a valid email address.
                </small>
            </div>

            <!-- Role Display (Read-only) -->
            <% if (user.roleName) { %>
                <div class="form-group">
                    <label>Role</label>
                    <div class="role-display">
                        <span class="role-badge role-<%= user.roleName %>">
                            <%= user.roleName %>
                        </span>
                    </div>
                    <small class="help-text">
                        Role cannot be changed here. Contact an administrator if you need to change your role.
                    </small>
                </div>
            <% } %>

            <!-- Actions -->
            <div class="form-actions">
                <a href="/dashboard" class="btn-secondary">Cancel</a>
                <button type="submit" class="btn-primary">Update Account</button>
            </div>
        </form>
    </div>

</main>

<%- include('../../partials/footer') %>