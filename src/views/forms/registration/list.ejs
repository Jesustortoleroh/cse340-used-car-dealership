<%- include('../../partials/header') %>

<main class="users-page">

    <div class="page-header">
        <h1 class="page-title"><%= title %></h1>
        <p class="page-subtitle">
            Below is a list of registered customers who have created
            accounts with our dealership.
        </p>
    </div>

    <% if (users && users.length > 0) { %>

        <div class="users-list">

            <% users.forEach(listUser => { %>
                <% 
                    // Calculate permissions for this user card
                    const currentUser = typeof user !== 'undefined' && user ? user : null;
                    const canEdit = currentUser && (currentUser.id === listUser.id || currentUser.roleName === 'owner');
                    const canDelete = currentUser && currentUser.roleName === 'owner' && currentUser.id !== listUser.id;
                %>

                <div class="user-card">

                    <div class="user-header">
                        <h3><%= listUser.name %></h3>
                        <span class="user-id">ID: <%= listUser.id %></span>
                    </div>

                    <div class="user-details">
                        <div class="detail-item">
                            <div class="label">Email</div>
                            <div class="value"><%= listUser.email %></div>
                        </div>

                        <% if (listUser.roleName) { %>
                            <div class="detail-item">
                                <div class="label">Role</div>
                                <div class="value">
                                    <span class="role-badge role-<%= listUser.roleName %>">
                                        <%= listUser.roleName %>
                                    </span>
                                </div>
                            </div>
                        <% } %>

                        <div class="detail-item">
                            <div class="label">Registered</div>
                            <div class="value">
                                <%= new Date(listUser.created_at).toLocaleDateString() %>
                            </div>
                        </div>
                    </div>

                    <!-- User Actions -->
                    <% if (canEdit || canDelete) { %>
                        <div class="user-actions">
                            <% if (canEdit) { %>
                                <a href="/register/<%= listUser.id %>/edit" class="btn-edit">
                                    ✏️ Edit
                                </a>
                            <% } %>
                            <% if (canDelete) { %>
                                <form method="POST" action="/register/<%= listUser.id %>/delete" class="delete-form">
                                    <!-- CSRF Token -->
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button 
                                        type="submit" 
                                        class="btn-delete" 
                                        onclick="return confirm('Are you sure you want to delete this user? This action cannot be undone.')"
                                    >
                                        🗑️ Delete
                                    </button>
                                </form>
                            <% } %>
                        </div>
                    <% } %>

                </div>

            <% }); %>

        </div>

    <% } else { %>

        <div class="no-users">
            <span class="empty-icon" aria-hidden="true">👥</span>
            <p>No customers have registered yet.</p>
        </div>

    <% } %>

    <div class="page-actions">
        <a href="/register" class="btn-primary">Create Another Account</a>
        <a href="/dashboard" class="btn-secondary">Back to Dashboard</a>
    </div>

</main>

<%- include('../../partials/footer') %>