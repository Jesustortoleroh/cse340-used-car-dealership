<%- include('../../partials/header') %>

<main>

    <h1><%= title %></h1>

    <p>
        Below are the inquiries submitted by potential customers interested in
        our vehicles and services.
    </p>

    <% if (messages && messages.error) { %>
        <div class="flash error">
            <%= messages.error %>
        </div>
    <% } %>

    <% if (messages && messages.success) { %>
        <div class="flash success">
            <%= messages.success %>
        </div>
    <% } %>

    <% if (inquiries && inquiries.length > 0) { %>

        <div class="contact-responses">

            <% inquiries.forEach(inquiry => { %>

                <div class="response-item">

                    <h3 class="response-subject">
                        <%= inquiry.subject %>
                    </h3>

                    <p>
                        <strong>Customer:</strong>
                        <%= inquiry.customer_name %>
                    </p>

                    <p>
                        <strong>Email:</strong>
                        <%= inquiry.email %>
                    </p>

                    <p>
                        <strong>Phone:</strong>
                        <%= inquiry.phone || 'Not Provided' %>
                    </p>

                    <p>
                        <strong>Status:</strong>
                        <span class="status-badge status-<%= inquiry.status ? inquiry.status.toLowerCase().replace(' ', '-') : 'received' %>">
                            <%= inquiry.status || 'Received' %>
                        </span>
                    </p>

                    <p>
                        <strong>Priority:</strong>
                        <%= inquiry.priority || 'Normal' %>
                    </p>

                    <p class="response-message">
                        <%= inquiry.message %>
                    </p>

                    <p class="response-date">
                        Submitted:
                        <%= new Date(inquiry.submitted || inquiry.created_at).toLocaleDateString() %>
                    </p>

                    <div class="inquiry-actions">
                        <a href="/contact/<%= inquiry.id %>" class="btn-view">
                            View Details
                        </a>
                    </div>

                </div>

            <% }); %>

        </div>

    <% } else { %>

        <div class="empty-state">
            <span class="empty-icon">📨</span>
            <p>No customer inquiries have been submitted yet.</p>
        </div>

    <% } %>

    <div class="contact-link">
        <a href="/contact" class="btn-primary">
            Submit a New Inquiry
        </a>
    </div>

</main>

<%- include('../../partials/footer') %>