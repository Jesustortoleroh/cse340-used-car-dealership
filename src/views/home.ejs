<%- include('partials/header') %>

<main class="home-page">

    <!-- Hero Section -->
    <section class="hero-section" aria-labelledby="hero-title">
        <div class="hero-content">
            <h1 id="hero-title">Find Your Perfect Used Vehicle</h1>
            <p class="hero-text">
                Quality pre-owned cars, SUVs, trucks, luxury vehicles,
                and electric vehicles from trusted dealerships across
                the country.
            </p>
            <div class="cta-buttons">
                <a href="/vehicles" class="btn btn-primary">Browse Inventory</a>
                <a href="/contact" class="btn btn-secondary">Contact Us</a>
            </div>
        </div>
        <div class="hero-image">
            <img src="/images/homecar.jpg" alt="A lineup of quality pre-owned vehicles at a dealership" class="hero-img" fetchpriority="high">
        </div>
    </section>

    <!-- Featured Vehicles -->
    <section class="home-section" aria-labelledby="featured-title">
        <h2 id="featured-title">Featured Vehicles</h2>

        <div class="carousel-container">
            <div class="carousel-track">
                <!-- Vehicle 1 -->
                    <% if (vehicles.length) { %>
                        <% vehicles.forEach(vehicle => { %>
                            <article class="vehicle-feature-card">
                                <% if (vehicle.image_url) { %>
                                    <img src="<%= vehicle.image_url %>" alt="<%= vehicle.name %>" loading="lazy">
                                <% } %>
                                <div class="card-content">
                                    <h3><%= vehicle.name %><% if (vehicle.year) { %> <%= vehicle.year %><% } %></h3>
                                    <p class="card-price">$<%= Number(vehicle.price).toLocaleString('en-US') %></p>
                                    <a href="/vehicles/<%= vehicle.slug %>" class="btn-primary" aria-label="View details for <%= vehicle.name %>">
                                        View Details
                                    </a>
                                </div>
                            </article>
                        <% }) %>
                    <% } else { %>
                        <p class="empty-state">No vehicles are currently available. Please check back soon.</p>
                    <% } %>
            </div>
        </div>
    </section>

    <!-- Statistics -->
    <section class="home-section stats-section" aria-labelledby="stats-title">
        <h2 id="stats-title">Dealership Statistics</h2>
        <div class="stats-grid">
            <div class="stat-card">
                <h3><%= stats.vehicles %></h3>
                <p>Vehicles Available</p>
            </div>
            <div class="stat-card">
                <h3><%= stats.dealers %></h3>
                <p>Trusted Dealers</p>
            </div>
            <div class="stat-card">
                <h3><%= stats.categories %></h3>
                <p>Vehicle Categories</p>
            </div>
            <div class="stat-card">
                <h3><%= stats.services %></h3>
                <p>Service Types</p>
            </div>
        </div>
    </section>

    <!-- Why Choose Us -->
    <section class="home-section" aria-labelledby="why-choose-title">
        <h2 id="why-choose-title">Why Choose Us?</h2>
        <div class="benefits-grid">
            <div class="benefit-card">
                <span aria-hidden="true">✅</span> Quality Inspected Vehicles
            </div>
            <div class="benefit-card">
                <span aria-hidden="true">💰</span> Competitive Pricing
            </div>
            <div class="benefit-card">
                <span aria-hidden="true">📋</span> Transparent Vehicle Information
            </div>
            <div class="benefit-card">
                <span aria-hidden="true">🤝</span> Trusted Dealership Network
            </div>
            <div class="benefit-card">
                <span aria-hidden="true">⭐</span> Customer Reviews
            </div>
            <div class="benefit-card">
                <span aria-hidden="true">🛠</span> Professional Service Support
            </div>
        </div>
    </section>

    <!-- Featured Dealer -->
    <section class="home-section" aria-labelledby="featured-dealer-title">
        <h2 id="featured-dealer-title">Featured Dealer</h2>
        <% if (dealer) { %>
            <div class="dealer-highlight">
                <h3><%= dealer.name %></h3>
                <p><%= dealer.location || 'Contact dealer for location details' %></p>
                <a href="/dealers/<%= dealer.slug %>" class="btn-primary">Visit Dealer</a>
            </div>
        <% } else { %>
            <p>Visit our <a href="/dealers">dealer directory</a> to explore our network.</p>
        <% } %>
    </section>

    <!-- Final Call To Action -->
    <section class="home-cta" aria-labelledby="cta-title">
        <h2 id="cta-title">Ready to Find Your Next Vehicle?</h2>
        <p>
            Explore our inventory and discover why drivers continue
            to trust our dealership for their automotive needs.
        </p>
        <div class="cta-buttons">
            <a href="/vehicles" class="btn btn-primary">Browse Inventory</a>
            <a href="/contact" class="btn btn-secondary">Contact Us</a>
        </div>
    </section>

</main>

<%- include('partials/footer') %>