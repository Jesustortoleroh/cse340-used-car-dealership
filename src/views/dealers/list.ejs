<%- include('../partials/header') %>

<main class="dealers-page">

    <h1 class="page-title">Dealers</h1>

    <!-- Sort Options Toolbar -->
    <div class="dealers-toolbar">
        <span class="sort-label">Sort by:</span>
        <div class="sort-links">
            <a href="/dealers?sort=name" class="<%= currentSort === 'name' ? 'active' : '' %>">Name</a>
            <a href="/dealers?sort=location" class="<%= currentSort === 'location' ? 'active' : '' %>">Location</a>
        </div>
    </div>

    <!-- Dealer Grid -->
    <div class="dealer-list">

        <% dealers.forEach(dealer => { %>

            <div class="dealer-card">

                <% if (dealer.image_url) { %>
                    <div class="dealer-image-wrapper">
                        <img
                            src="<%= dealer.image_url %>"
                            alt="<%= dealer.name %>"
                            class="dealer-image"
                            loading="lazy"
                        >
                    </div>
                <% } %>

                <div class="dealer-info">
                    <h3>
                        <a href="/dealers/<%= dealer.slug %>"><%= dealer.name %></a>
                    </h3>
                    <p class="dealer-location">
                        <span aria-hidden="true">📍</span> <%= dealer.location %>
                    </p>
                    <a href="/dealers/<%= dealer.slug %>" class="btn-view-dealer">
                        View Dealer →
                    </a>
                </div>

            </div>

        <% }) %>

    </div>

</main>

<%- include('../partials/footer') %>