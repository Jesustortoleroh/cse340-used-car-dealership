<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- CSRF Token for AJAX requests -->
    <meta name="csrf-token" content="<%= csrfToken %>">

    <!-- Title and Favicon (NeoMotor) -->
    <!-- Note: The emoji is only in the favicon to avoid duplication in the browser tab -->
    <title>NeoMotor | <%= title %></title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>⚡</text></svg>">
    
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/error.css">
    <link rel="stylesheet" href="/css/theme-toggle.css">
    
    <%- renderStyles() %>
    <%- renderScripts() %>

    <!-- Prevent FOUC (Flash of Unstyled Content) for Dark Mode -->
    <script>
        (function() {
            const savedTheme = localStorage.getItem('theme');
            // Force dark mode by default if no theme is saved
            if (savedTheme) {
                document.documentElement.setAttribute('data-theme', savedTheme);
            } else {
                document.documentElement.setAttribute('data-theme', 'dark');
            }
        })();
    </script>

    <% if (NODE_ENV.includes('dev')) { %>
    <script>
        const host = window.location.hostname;
        const currentPort = window.location.port;
        const wsPort = currentPort ? (parseInt(currentPort) + 1) : 3001;
        const ws = new WebSocket(`ws://${host}:${wsPort}`);
        ws.onclose = () => {
            setTimeout(() => location.reload(), 2000);
        };
    </script>
    <% } %>
</head>
<body>
    <!-- Main navigation header -->
    <header>
        <nav class="main-nav" aria-label="Main navigation">
            <div class="nav-top">
                <!-- Mobile menu toggle button -->
                <button
                    class="menu-toggle"
                    id="menu-toggle"
                    aria-label="Toggle navigation"
                    aria-expanded="false"
                    aria-controls="nav-menu"
                >
                    ☰
                </button>
            </div>

            <!-- Navigation menu list -->
            <ul id="nav-menu">
                <!-- Brand Logo -->
                <li class="nav-brand">
                    <a href="/" style="font-size: 1.2rem; font-weight: 800; color: var(--primary); text-decoration: none; letter-spacing: 1px; display: flex; align-items: center; gap: 0.5rem;">
                        ⚡ NeoMotor
                    </a>
                </li>

                <!-- Always visible links -->
                <li><a href="/">Home</a></li>
                <li><a href="/about">About</a></li>
                <li><a href="/vehicles">Vehicles</a></li>
                <li><a href="/dealers">Dealers</a></li>
                <li><a href="/contact">Contact</a></li>
                <li><a href="/compare">🚗 Compare</a></li>

                <!-- Conditional content for logged-in users -->
                <% if (isLoggedIn) { %>
                    <li><a href="/dashboard">Dashboard</a></li>
                    <li><a href="/favorites">❤️ Favorites</a></li>
                    <li><a href="/profile">👤 Profile</a></li>

                    <!-- Notifications link -->
                    <li class="notification-link-wrapper">
                        <a href="/notifications" class="notification-link" aria-label="Notifications">
                            🔔
                            <% if (unreadNotifications > 0) { %>
                                <span class="notification-badge"><%= unreadNotifications %></span>
                            <% } %>
                        </a>
                    </li>

                    <!-- Conditional content for employee or owner roles -->
                    <% if (user && (user.roleName === 'employee' || user.roleName === 'owner')) { %>
                        <li><a href="/register/list">Register List</a></li>
                        <li><a href="/contact/responses">Inquiries</a></li>
                    <% } %>

                    <li><a href="/logout">Logout</a></li>

                <% } else { %>
                    <li><a href="/login">Login</a></li>
                    <li><a href="/register">Create Account</a></li>
                <% } %>

                <!-- Theme Toggle Button -->
                <li class="theme-toggle-item">
                    <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme">
                        <span class="theme-icon" aria-hidden="true">🌙</span>
                    </button>
                </li>
            </ul>
        </nav>
    </header>

    <!-- Flash messages display -->
    <%
    const messages = typeof flash === 'function' 
        ? flash() 
        : { success: [], error: [], warning: [], info: [] };

    const hasMessages = Object.keys(messages).some(type => 
        Array.isArray(messages[type]) && messages[type].some(msg => msg && msg.trim() !== '')
    );
    %>

    <% if (hasMessages) { %>
        <div class="flash-messages">
            <% Object.keys(messages).forEach(type => { %>
                <% if (Array.isArray(messages[type])) { %>
                    <% messages[type].forEach(message => { %>
                        <% if (message && message.trim() !== '') { %>
                            <div class="flash <%= type %>" role="alert">
                                <%= message %>
                            </div>
                        <% } %>
                    <% }); %>
                <% } %>
            <% }); %>
        </div>
    <% } %>

    <!-- JavaScript files -->
    <script src="/js/navigation.js"></script>
    <script src="/js/theme.js"></script>
</body>
</html>