<%- include('partials/header') %>

<main>

    <h1><%= title %></h1>

    <% if (user) { %>

        <div class="dashboard-container">

            <!-- User Profile -->
            <section class="user-profile">

             <h2><%= greeting %></h2>
             
             <p class="dashboard-subtitle">

            <% if (user.roleName === 'customer') { %>
            Browse vehicles, submit service requests, and manage your dealership interactions.
            <% } %>

            <% if (user.roleName === 'employee') { %>
            Manage customer inquiries and service requests.
            <% } %>

            <% if (user.roleName === 'owner') { %>
            Oversee dealership operations and user management.
            <% } %>

           </p>

                <div class="user-details">

                    <div class="detail-item">
                        <span class="label">Name:</span>
                        <span class="value">
                            <%= user.name %>
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="label">Email:</span>
                        <span class="value">
                            <%= user.email %>
                        </span>
                    </div>

                   <div class="detail-item">
                        <span class="label">Role:</span>
                        <span class="role-badge role-<%= user.roleName %>">
                            <%= user.roleName %>
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="label">Member Since:</span>
                        <span class="value">
                            <%= new Date(user.created_at).toLocaleDateString() %>
                        </span>
                    </div>

                </div>

            </section>

            <!-- Dashboard Cards Grid -->
            <section class="dashboard-cards">

                <h2>Quick Access</h2>

                <div class="cards-grid">

                    <!-- My Profile -->
                    <a href="/profile" class="dashboard-card">
                        <div class="card-icon">👤</div>
                        <h3>My Profile</h3>
                        <p>View account information</p>
                    </a>

                    <!-- Browse Vehicles -->
                    <a href="/vehicles" class="dashboard-card">
                        <div class="card-icon">🚗</div>
                        <h3>Browse Vehicles</h3>
                        <p>Explore our inventory</p>
                    </a>

                    <!-- View Dealers -->
                    <a href="/dealers" class="dashboard-card">
                        <div class="card-icon">🏪</div>
                        <h3>View Dealers</h3>
                        <p>Find dealerships</p>
                    </a>

                    <!-- Favorites Card -->
                    <a href="/favorites" class="dashboard-card">
                        <div class="card-icon">❤️</div>
                        <h3>My Favorites</h3>
                        <p>View your saved vehicles</p>
                    </a>

                    <!-- Service Requests -->
                    <a href="/service-requests" class="dashboard-card">
                        <div class="card-icon">🔧</div>
                        <h3>Service Requests</h3>
                        <p>Manage your requests</p>
                    </a>

                    <!-- Submit Service Request -->
                    <a href="/service-requests/create" class="dashboard-card">
                        <div class="card-icon">📝</div>
                        <h3>Submit Request</h3>
                        <p>New service request</p>
                    </a>

                    <!-- Contact Dealership -->
                    <a href="/contact" class="dashboard-card">
                        <div class="card-icon">📧</div>
                        <h3>Contact</h3>
                        <p>Get in touch</p>
                    </a>

                </div>

            </section>

            <!-- Customer Tools -->
            <section class="dashboard-actions">

                <h2>Customer Tools</h2>

                <ul>

                    <li>
                        <a href="/vehicles">
                            Browse Vehicles
                        </a>
                    </li>

                    <li>
                        <a href="/dealers">
                            View Dealers
                        </a>
                    </li>

                    <li>
                        <a href="/service-requests">
                            Service Requests
                        </a>
                    </li>

                    <li>
                        <a href="/service-requests/create">
                            Submit Service Request
                        </a>
                    </li>

                    <li>
                        <a href="/contact">
                            Contact Dealership
                        </a>
                    </li>

                </ul>

            </section>

            <!-- Employee & Owner Tools -->
            <% if (
                user.roleName === 'employee' ||
                user.roleName === 'owner'
            ) { %>

                <section class="dashboard-actions">

                    <h2>Staff Tools</h2>

                    <ul>

                        <li>
                            <a href="/contact/responses">
                                View Contact Responses
                            </a>
                        </li>

                        <li>
                            <a href="/service-requests">
                                Manage Service Requests
                            </a>
                        </li>

                    </ul>

                </section>

            <% } %>

            <!-- Owner Tools -->
            <% if (user.roleName === 'owner') { %>

                <section class="dashboard-actions">

                    <h2>Administration</h2>

                    <ul>

                        <li>
                            <a href="/register/list">
                                Manage Users
                            </a>
                        </li>

                    </ul>

                </section>

            <% } %>

        </div>

    <% } else { %>

        <p>
            Please log in to view your dashboard.
        </p>

    <% } %>

</main>

<%- include('partials/footer') %>
