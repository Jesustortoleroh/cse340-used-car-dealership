<%- include('partials/header') %>

<main>

    <h1><%= title %></h1>

    <% if (user) { %>

        <!-- ==========================================
        Analytics Cards
        ========================================== -->
        <section class="analytics-section" aria-label="Dashboard Analytics">

            <!-- Customer Analytics -->
            <div class="analytics-grid">

                <div class="analytics-card">
                    <div class="analytics-icon" aria-hidden="true">❤️</div>
                    <div class="analytics-number"><%= analytics.customer.favorites %></div>
                    <div class="analytics-label">Favorite Vehicles</div>
                    <a href="/favorites" class="analytics-link" aria-label="View all favorite vehicles">View All →</a>
                </div>

                <div class="analytics-card">
                    <div class="analytics-icon" aria-hidden="true">⭐</div>
                    <div class="analytics-number"><%= analytics.customer.reviews %></div>
                    <div class="analytics-label">Reviews Submitted</div>
                    <a href="/vehicles" class="analytics-link" aria-label="Write a new review">Write Review →</a>
                </div>

                <div class="analytics-card">
                    <div class="analytics-icon" aria-hidden="true">🔧</div>
                    <div class="analytics-number"><%= analytics.customer.requests %></div>
                    <div class="analytics-label">Service Requests</div>
                    <a href="/service-requests" class="analytics-link" aria-label="View all service requests">View All →</a>
                </div>

            </div>

            <!-- Employee Analytics -->
            <% if (user.roleName === 'employee' || user.roleName === 'owner') { %>
                <div class="analytics-grid employee-analytics">
                    <div class="analytics-card">
                        <div class="analytics-icon" aria-hidden="true">📨</div>
                        <div class="analytics-number"><%= analytics.employee.openInquiries %></div>
                        <div class="analytics-label">Open Inquiries</div>
                        <a href="/contact/responses" class="analytics-link" aria-label="View open inquiries">View All →</a>
                    </div>

                    <div class="analytics-card">
                        <div class="analytics-icon" aria-hidden="true">🔧</div>
                        <div class="analytics-number"><%= analytics.employee.pendingRequests %></div>
                        <div class="analytics-label">Pending Requests</div>
                        <a href="/service-requests" class="analytics-link" aria-label="View pending service requests">View All →</a>
                    </div>

                    <div class="analytics-card">
                        <div class="analytics-icon" aria-hidden="true">🚗</div>
                        <div class="analytics-number"><%= analytics.employee.totalVehicles %></div>
                        <div class="analytics-label">Total Vehicles</div>
                        <a href="/vehicles" class="analytics-link" aria-label="View all vehicles">View All →</a>
                    </div>
                </div>
            <% } %>

            <!-- Owner Analytics -->
            <% if (user.roleName === 'owner') { %>
                <div class="analytics-grid owner-analytics">
                    <div class="analytics-card">
                        <div class="analytics-icon" aria-hidden="true">👥</div>
                        <div class="analytics-number"><%= analytics.owner.totalUsers %></div>
                        <div class="analytics-label">Total Users</div>
                        <a href="/register/list" class="analytics-link" aria-label="View all users">View All →</a>
                    </div>

                    <div class="analytics-card">
                        <div class="analytics-icon" aria-hidden="true">🚗</div>
                        <div class="analytics-number"><%= analytics.owner.totalVehicles %></div>
                        <div class="analytics-label">Total Vehicles</div>
                        <a href="/vehicles" class="analytics-link" aria-label="View all vehicles">View All →</a>
                    </div>

                    <div class="analytics-card">
                        <div class="analytics-icon" aria-hidden="true">🏢</div>
                        <div class="analytics-number"><%= analytics.owner.totalDealers %></div>
                        <div class="analytics-label">Total Dealers</div>
                        <a href="/dealers" class="analytics-link" aria-label="View all dealers">View All →</a>
                    </div>

                    <div class="analytics-card">
                        <div class="analytics-icon" aria-hidden="true">⭐</div>
                        <div class="analytics-number"><%= analytics.owner.totalReviews %></div>
                        <div class="analytics-label">Total Reviews</div>
                        <a href="/vehicles" class="analytics-link" aria-label="View all reviews">View All →</a>
                    </div>
                </div>
            <% } %>

        </section>

        <!-- ==========================================
        Dashboard Container
        ========================================== -->
        <div class="dashboard-container">

            <!-- User Profile -->
            <section class="user-profile" aria-labelledby="user-profile-title">

             <h2 id="user-profile-title"><%= greeting %></h2>
             
             <p class="dashboard-subtitle">

            <% if (user.roleName === 'customer') { %>
            Browse vehicles, submit service requests, and manage your dealership interactions.
            <% } %>

            <% if (user.roleName === 'employee') { %>
            Manage customer inquiries and service requests.
            <% } %>

            <% if (user.roleName === 'owner') { %>
            Oversee dealership operations and user management.
            <% } %>

           </p>

                <!-- Using Description List for better semantics -->
                <dl class="user-details">

                    <div class="detail-item">
                        <dt class="label">Name:</dt>
                        <dd class="value"><%= user.name %></dd>
                    </div>

                    <div class="detail-item">
                        <dt class="label">Email:</dt>
                        <dd class="value"><%= user.email %></dd>
                    </div>

                   <div class="detail-item">
                        <dt class="label">Role:</dt>
                        <dd class="value">
                            <span class="role-badge role-<%= user.roleName %>">
                                <%= user.roleName %>
                            </span>
                        </dd>
                    </div>

                    <div class="detail-item">
                        <dt class="label">Member Since:</dt>
                        <dd class="value">
                            <%= new Date(user.created_at).toLocaleDateString() %>
                        </dd>
                    </div>

                </dl>

            </section>

            <!-- Dashboard Cards Grid -->
            <section class="dashboard-cards" aria-labelledby="quick-access-title">

                <h2 id="quick-access-title">Quick Access</h2>

                <div class="cards-grid">

                    <!-- My Profile -->
                    <a href="/profile" class="dashboard-card">
                        <div class="card-icon" aria-hidden="true">👤</div>
                        <h3>My Profile</h3>
                        <p>View account information</p>
                    </a>

                    <!-- Browse Vehicles -->
                    <a href="/vehicles" class="dashboard-card">
                        <div class="card-icon" aria-hidden="true">🚗</div>
                        <h3>Browse Vehicles</h3>
                        <p>Explore our inventory</p>
                    </a>

                    <!-- View Dealers -->
                    <a href="/dealers" class="dashboard-card">
                        <div class="card-icon" aria-hidden="true">🏪</div>
                        <h3>View Dealers</h3>
                        <p>Find dealerships</p>
                    </a>

                    <!-- Favorites Card -->
                    <a href="/favorites" class="dashboard-card">
                        <div class="card-icon" aria-hidden="true">❤️</div>
                        <h3>My Favorites</h3>
                        <p>View your saved vehicles</p>
                    </a>

                    <!-- Service Requests -->
                    <a href="/service-requests" class="dashboard-card">
                        <div class="card-icon" aria-hidden="true">🔧</div>
                        <h3>Service Requests</h3>
                        <p>Manage your requests</p>
                    </a>

                    <!-- Submit Service Request -->
                    <a href="/service-requests/create" class="dashboard-card">
                        <div class="card-icon" aria-hidden="true">📝</div>
                        <h3>Submit Request</h3>
                        <p>New service request</p>
                    </a>

                    <!-- Contact Dealership -->
                    <a href="/contact" class="dashboard-card">
                        <div class="card-icon" aria-hidden="true">📧</div>
                        <h3>Contact</h3>
                        <p>Get in touch</p>
                    </a>

                    <!-- Compare Vehicles -->
                    <a href="/compare" class="dashboard-card">
                        <div class="card-icon" aria-hidden="true">📊</div>
                        <h3>Compare Vehicles</h3>
                        <p>Compare side by side</p>
                    </a>

                </div>

            </section>

            <!-- Customer Tools -->
            <section class="dashboard-actions" aria-labelledby="customer-tools-title">

                <h2 id="customer-tools-title">Customer Tools</h2>

                <ul>
                    <li><a href="/vehicles">Browse Vehicles</a></li>
                    <li><a href="/dealers">View Dealers</a></li>
                    <li><a href="/service-requests">Service Requests</a></li>
                    <li><a href="/service-requests/create">Submit Service Request</a></li>
                    <li><a href="/contact">Contact Dealership</a></li>
                </ul>

            </section>

            <!-- Employee & Owner Tools -->
            <% if (user.roleName === 'employee' || user.roleName === 'owner') { %>

                <section class="dashboard-actions" aria-labelledby="staff-tools-title">

                    <h2 id="staff-tools-title">Staff Tools</h2>

                    <ul>
                        <li><a href="/contact/responses">View Contact Responses</a></li>
                        <li><a href="/service-requests">Manage Service Requests</a></li>
                    </ul>

                </section>

            <% } %>

            <!-- Owner Tools -->
            <% if (user.roleName === 'owner') { %>

                <section class="dashboard-actions" aria-labelledby="admin-tools-title">

                    <h2 id="admin-tools-title">Administration</h2>

                    <ul>
                        <li><a href="/register/list">Manage Users</a></li>
                    </ul>

                </section>

            <% } %>

        </div>

    <% } else { %>

        <p>Please log in to view your dashboard.</p>

    <% } %>

</main>

<%- include('partials/footer') %>