<%- include('../partials/header') %>

<main>

    <h1>🚗 Compare Vehicles</h1>
    <p class="compare-subtitle">Select up to 3 vehicles to compare side by side</p>

    <% if (messages && messages.error) { %>
        <div class="flash error"><%= messages.error %></div>
    <% } %>

    <form action="/compare" method="POST" class="compare-form">
        <div class="compare-selectors">
            <div class="selector-group">
                <label>Vehicle 1</label>
                <select name="vehicle1" required>
                    <option value="">Select a vehicle...</option>
                    <% vehicles.forEach(vehicle => { %>
                        <option value="<%= vehicle.id %>">
                            <%= vehicle.name %> ($<%= vehicle.price.toLocaleString() %>)
                        </option>
                    <% }) %>
                </select>
            </div>

            <div class="selector-group">
                <label>Vehicle 2</label>
                <select name="vehicle2" required>
                    <option value="">Select a vehicle...</option>
                    <% vehicles.forEach(vehicle => { %>
                        <option value="<%= vehicle.id %>">
                            <%= vehicle.name %> ($<%= vehicle.price.toLocaleString() %>)
                        </option>
                    <% }) %>
                </select>
            </div>

            <div class="selector-group">
                <label>Vehicle 3 (Optional)</label>
                <select name="vehicle3">
                    <option value="">Select a vehicle...</option>
                    <% vehicles.forEach(vehicle => { %>
                        <option value="<%= vehicle.id %>">
                            <%= vehicle.name %> ($<%= vehicle.price.toLocaleString() %>)
                        </option>
                    <% }) %>
                </select>
            </div>
        </div>

        <button type="submit" class="btn-compare">Compare Vehicles 🔍</button>
    </form>

    <div class="compare-tips">
        <h3>💡 Tips for comparing</h3>
        <ul>
            <li>Compare vehicles from the same category for better insights</li>
            <li>Consider price, year, mileage, and transmission</li>
            <li>Look at the specifications for detailed differences</li>
        </ul>
    </div>

</main>

<%- include('../partials/footer') %>