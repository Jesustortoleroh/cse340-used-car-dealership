<%- include('../partials/header') %>

<main>

    <% if (flash) { %>

        <% if (flash.error) { %>
            <div class="flash error">
                <%= flash.error %>
            </div>
        <% } %>

        <% if (flash.success) { %>
            <div class="flash success">
                <%= flash.success %>
            </div>
        <% } %>

    <% } %>

    <h1><%= title %></h1>

    <!-- Results count -->
    <p class="results-count">
        Showing <strong><%= favorites.length %></strong> <%= favorites.length === 1 ? 'vehicle' : 'vehicles' %>
        in your favorites
    </p>

    <!-- Vehicle Grid -->
    <% if (favorites && favorites.length > 0) { %>

        <div class="vehicle-list">

            <% favorites.forEach(vehicle => { %>

                <div class="vehicle-card">

                    <% if (vehicle.image_url) { %>

                        <img src="<%= vehicle.image_url %>"
                            alt="<%= vehicle.name %>"
                            class="vehicle-image"
                        >

                    <% } %>

                    <div class="vehicle-info">

                        <h3>
                            <a href="/vehicles/<%= vehicle.slug %>">
                                <%= vehicle.name %>
                            </a>
                        </h3>

                        <p class="vehicle-price">
                            $<%= vehicle.price.toLocaleString() %>
                        </p>

                        <p class="vehicle-category">
                            Category: <%= vehicle.category_name || 'Uncategorized' %>
                        </p>

                        <% if (vehicle.average_rating) { %>

                            <div class="vehicle-rating">

                                <% for(let i = 0; i < 5; i++) { %>

                                    <% if(i < Math.round(vehicle.average_rating)) { %>

                                        <span class="star filled">
                                            ★
                                        </span>

                                    <% } else { %>

                                        <span class="star">
                                            ★
                                        </span>

                                    <% } %>

                                <% } %>

                                <span class="rating-count">
                                    (<%= vehicle.review_count || 0 %>)
                                </span>

                            </div>

                        <% } %>

                        <!-- Actions: View Details + Remove -->
                        <div class="favorite-actions">

                            <a href="/vehicles/<%= vehicle.slug %>" class="btn-view-details">
                                View Details →
                            </a>

                            <form action="/favorites/<%= vehicle.id %>/remove" method="POST" class="inline-form">
                                <button type="submit" class="btn-remove-favorite" onclick="return confirm('Remove this vehicle from your favorites?')">
                                    ❌ Remove
                                </button>
                            </form>

                        </div>

                    </div>

                </div>

            <% }) %>

        </div>

    <% } else { %>

        <div class="empty-state">

            <span class="empty-icon">
                ❤️
            </span>

            <p>
                You haven't added any vehicles to your favorites yet.
            </p>

            <p class="empty-sub">
                Start browsing vehicles and save your favorites!
                <br>
                <a href="/vehicles" class="view-all-link">Browse Vehicles</a>
            </p>

        </div>

    <% } %>

</main>

<%- include('../partials/footer') %>