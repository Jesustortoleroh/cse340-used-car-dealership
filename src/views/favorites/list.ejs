<%- include('../partials/header') %>

<main class="favorites-page">

    <h1 class="page-title"><%= title %></h1>

    <!-- Results count -->
    <p class="results-count">
        Showing <strong><%= favorites.length %></strong> <%= favorites.length === 1 ? 'vehicle' : 'vehicles' %>
        in your favorites
    </p>

    <!-- Vehicle Grid -->
    <% if (favorites && favorites.length > 0) { %>

        <div class="vehicle-list">

            <% favorites.forEach(vehicle => { %>

                <div class="vehicle-card">

                    <% if (vehicle.image_url) { %>
                        <div class="vehicle-image-wrapper">
                            <img src="<%= vehicle.image_url %>"
                                alt="<%= vehicle.name %>"
                                class="vehicle-image"
                                loading="lazy"
                            >
                        </div>
                    <% } %>

                    <div class="vehicle-info">

                        <h3>
                            <a href="/vehicles/<%= vehicle.slug %>">
                                <%= vehicle.name %>
                            </a>
                        </h3>

                        <p class="vehicle-category">
                            Category: <%= vehicle.category_name || 'Uncategorized' %>
                        </p>

                        <% if (vehicle.average_rating) { %>
                            <div class="vehicle-rating" aria-label="Rating: <%= Math.round(vehicle.average_rating) %> out of 5 stars">
                                <% for(let i = 0; i < 5; i++) { %>
                                    <span class="star <%= i < Math.round(vehicle.average_rating) ? 'filled' : '' %>" aria-hidden="true">★</span>
                                <% } %>
                                <span class="rating-count">
                                    (<%= vehicle.review_count || 0 %>)
                                </span>
                            </div>
                        <% } %>

                        <!-- Actions: View Details + Remove -->
                        <div class="vehicle-card-footer">
                            <p class="vehicle-price">$<%= vehicle.price.toLocaleString() %></p>
                            
                            <div class="favorite-actions">
                                <a href="/vehicles/<%= vehicle.slug %>" class="btn-view-details">
                                    View Details →
                                </a>

                                <form action="/favorites/<%= vehicle.id %>/remove" method="POST" class="inline-form">
                                    <!-- CSRF Token (Required for security) -->
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="btn-remove-favorite" onclick="return confirm('Remove this vehicle from your favorites?')">
                                        ❌ Remove
                                    </button>
                                </form>
                            </div>
                        </div>

                    </div>

                </div>

            <% }) %>

        </div>

    <% } else { %>

        <div class="empty-state">

            <span class="empty-icon" aria-hidden="true">❤️</span>

            <p>
                You haven't added any vehicles to your favorites yet.
            </p>

            <p class="empty-sub">
                Start browsing vehicles and save your favorites!
                <br>
                <a href="/vehicles" class="view-all-link">Browse Vehicles</a>
            </p>

        </div>

    <% } %>

</main>

<%- include('../partials/footer') %>