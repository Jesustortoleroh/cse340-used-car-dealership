<%- include('../partials/header') %>

<main class="vehicles-page">

    <h1 class="page-title"><%= title %></h1>

    <!-- ==========================================
         Vehicle Search Toolbar (Glassmorphism)
    ========================================== -->
    <div class="vehicles-toolbar">
        <form action="/vehicles" method="GET" class="vehicle-search-form" role="search">
            
            <!-- Search input -->
            <div class="search-group">
                <label for="search-input" class="visually-hidden">Search vehicles</label>
                <input 
                    type="text" 
                    id="search-input"
                    name="search" 
                    placeholder="🔍 Search by name, description, or VIN..."
                    value="<%= queryParams && queryParams.search ? queryParams.search : '' %>"
                    class="search-input"
                    aria-label="Search vehicles by name, description, or VIN"
                >
            </div>

            <!-- Category filter -->
            <div class="filter-group">
                <label for="category-select" class="visually-hidden">Filter by category</label>
                <select name="category" id="category-select" class="category-select" aria-label="Filter by category">
                    <option value="All" <%= currentCategory === 'All' ? 'selected' : '' %>>All Categories</option>
                    <% categories.forEach(category => { %>
                        <option value="<%= category.name %>" <%= currentCategory === category.name ? 'selected' : '' %>>
                            <%= category.name %>
                        </option>
                    <% }) %>
                </select>
            </div>

            <div class="filter-group">
                <label for="min-price" class="visually-hidden">Minimum price</label>
                <input id="min-price" name="minPrice" type="number" min="0" step="100" placeholder="Min price"
                    value="<%= queryParams.minPrice %>" aria-label="Minimum price">
            </div>
            <div class="filter-group">
                <label for="max-price" class="visually-hidden">Maximum price</label>
                <input id="max-price" name="maxPrice" type="number" min="0" step="100" placeholder="Max price"
                    value="<%= queryParams.maxPrice %>" aria-label="Maximum price">
            </div>
            <div class="filter-group">
                <label for="min-year" class="visually-hidden">Minimum year</label>
                <input id="min-year" name="minYear" type="number" min="1900" max="<%= new Date().getFullYear() + 1 %>"
                    placeholder="From year" value="<%= queryParams.minYear %>" aria-label="Minimum model year">
            </div>
            <div class="filter-group">
                <label for="max-year" class="visually-hidden">Maximum year</label>
                <input id="max-year" name="maxYear" type="number" min="1900" max="<%= new Date().getFullYear() + 1 %>"
                    placeholder="To year" value="<%= queryParams.maxYear %>" aria-label="Maximum model year">
            </div>
            <div class="filter-group">
                <label for="max-mileage" class="visually-hidden">Maximum mileage</label>
                <input id="max-mileage" name="maxMileage" type="number" min="0" step="1000" placeholder="Max mileage"
                    value="<%= queryParams.maxMileage %>" aria-label="Maximum mileage">
            </div>
            <div class="filter-group">
                <label for="dealer-select" class="visually-hidden">Filter by dealer</label>
                <select name="dealer" id="dealer-select" aria-label="Filter by dealer">
                    <option value="">All Dealers</option>
                    <% dealers.forEach(dealer => { %>
                        <option value="<%= dealer.slug %>" <%= queryParams.dealer === dealer.slug ? 'selected' : '' %>>
                            <%= dealer.name %>
                        </option>
                    <% }) %>
                </select>
            </div>

            <!-- Sort filter -->
            <div class="filter-group">
                <label for="sort-select" class="visually-hidden">Sort vehicles</label>
                <select name="sort" id="sort-select" class="sort-select" aria-label="Sort vehicles">
                    <option value="name_asc" <%= queryParams && queryParams.sort === 'name_asc' ? 'selected' : '' %>>Name: A to Z</option>
                    <option value="price_asc" <%= queryParams && queryParams.sort === 'price_asc' ? 'selected' : '' %>>Price: Low to High</option>
                    <option value="price_desc" <%= queryParams && queryParams.sort === 'price_desc' ? 'selected' : '' %>>Price: High to Low</option>
                    <option value="name_desc" <%= queryParams && queryParams.sort === 'name_desc' ? 'selected' : '' %>>Name: Z to A</option>
                    <option value="newest" <%= queryParams && queryParams.sort === 'newest' ? 'selected' : '' %>>Newest First</option>
                    <option value="year_desc" <%= queryParams.sort === 'year_desc' ? 'selected' : '' %>>Newest Model Year</option>
                    <option value="mileage_asc" <%= queryParams.sort === 'mileage_asc' ? 'selected' : '' %>>Lowest Mileage</option>
                </select>
            </div>

            <!-- Action Buttons -->
            <div class="search-actions">
                <button type="submit" class="btn-search">Search</button>
                
                <% if (queryParams.search || queryParams.category !== 'All' || queryParams.minPrice !== '' || queryParams.maxPrice !== '' || queryParams.minYear !== '' || queryParams.maxYear !== '' || queryParams.maxMileage !== '' || queryParams.dealer || queryParams.sort !== 'name_asc') { %>
                    <a href="/vehicles" class="btn-clear" title="Clear filters">
                        <span aria-hidden="true">✕</span> Clear
                    </a>
                <% } %>
            </div>
        </form>
    </div>

    <!-- Results count -->
    <p class="results-count" role="status" aria-live="polite">
        <% if (vehicleCount > 0) { %>
            Showing <strong><%= pagination.start %>-<%= pagination.end %></strong> of <strong><%= vehicleCount %></strong> vehicles
        <% } else { %>
            No vehicles found
        <% } %>
        <% if (queryParams && queryParams.search) { %>
            matching "<strong><%= queryParams.search %></strong>"
        <% } %>
        <% if (currentCategory && currentCategory !== 'All') { %>
            in <strong><%= currentCategory %></strong>
        <% } %>
        <% if (queryParams && queryParams.sort && queryParams.sort !== 'name_asc') { %>
            <span class="sort-indicator">• Sorted by: <strong><%= sortLabel %></strong></span>
        <% } %>
    </p>

    <!-- Vehicle Grid -->
    <% if (vehicles && vehicles.length > 0) { %>

        <div class="vehicle-list">

            <% vehicles.forEach(vehicle => { %>

                <div class="vehicle-card">
                    <!-- Image -->
                    <% if (vehicle.image_url) { %>
                        <div class="vehicle-image-wrapper">
                            <img src="<%= vehicle.image_url %>" alt="<%= vehicle.name %>" class="vehicle-image" loading="lazy">
                        </div>
                    <% } %>

                    <!-- Info -->
                    <div class="vehicle-info">
                        <h3>
                            <a href="/vehicles/<%= vehicle.slug %>"><%= vehicle.name %></a>
                        </h3>

                        <p class="vehicle-category">Category: <%= vehicle.category %></p>
                        <% if (vehicle.year || vehicle.mileage !== null) { %>
                            <p class="vehicle-meta">
                                <% if (vehicle.year) { %><%= vehicle.year %><% } %>
                                <% if (vehicle.mileage !== null) { %> · <%= Number(vehicle.mileage).toLocaleString() %> mi<% } %>
                            </p>
                        <% } %>
                        <% if (vehicle.dealer) { %>
                            <p class="vehicle-dealer"><%= vehicle.dealer %></p>
                        <% } %>
                        
                        <div class="vehicle-rating-wrapper">
                            <% if (vehicle.average_rating) { %>
                                <div class="vehicle-rating" aria-label="Rating: <%= Math.round(vehicle.average_rating) %> out of 5 stars">
                                    <% for(let i = 0; i < 5; i++) { %>
                                        <span class="star <%= i < Math.round(vehicle.average_rating) ? 'filled' : '' %>" aria-hidden="true">★</span>
                                    <% } %>
                                    <span class="rating-count">(<%= vehicle.review_count || 0 %>)</span>
                                </div>
                            <% } else { %>
                                <span class="rating-count text-muted">No reviews yet</span>
                            <% } %>
                        </div>

                        <div class="vehicle-card-footer">
                            <p class="vehicle-price">$<%= Number(vehicle.price).toLocaleString('en-US') %></p>
                            <a href="/vehicles/<%= vehicle.slug %>" class="btn-view-details" aria-label="View details for <%= vehicle.name %>">
                                View Details →
                            </a>
                        </div>
                    </div>
                </div>

            <% }) %>

        </div>

    <% } else { %>

        <div class="empty-state">
            <span class="empty-icon" aria-hidden="true">🚗</span>
            <p>
                <% if (queryParams && queryParams.search) { %>
                    No vehicles found matching "<%= queryParams.search %>".
                <% } else { %>
                    No vehicles available in this category.
                <% } %>
            </p>
            <p class="empty-sub">
                <% if (queryParams && queryParams.search) { %>
                    Try adjusting your search terms or browse all vehicles.
                    <br>
                    <a href="/vehicles" class="view-all-link">View all vehicles</a>
                <% } else { %>
                    Check back later for new inventory!
                <% } %>
            </p>
        </div>

    <% } %>

    <% if (pagination.pageCount > 1) { %>
        <nav class="inventory-pagination" aria-label="Vehicle pages">
            <% if (pagination.previousUrl) { %>
                <a href="<%= pagination.previousUrl %>" rel="prev">Previous</a>
            <% } %>
            <span aria-current="page">Page <%= pagination.page %> of <%= pagination.pageCount %></span>
            <% if (pagination.nextUrl) { %>
                <a href="<%= pagination.nextUrl %>" rel="next">Next</a>
            <% } %>
        </nav>
    <% } %>

</main>

<%- include('../partials/footer') %>